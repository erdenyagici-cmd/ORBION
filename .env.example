# ─────────────────────────────────────────────────────────────
#  ORBION — example environment
#  Copy to .env  (chmod 600) and fill in your own values.
#  NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
AGENT_PORT=8090
WEB_PORT=8090
PANEL_PUBLIC_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:4b

# ── Panel authentication ─────────────────────────────────────
# A random, long password. The panel refuses to start without it.
PANEL_PASSWORD=change_me_to_a_long_random_string
# Session signing secret (separate from the password).
PANEL_SESSION_KEY=change_me_to_another_random_string
# Optional: restrict CORS to your panel origin (recommended).
PANEL_ALLOWED_ORIGINS=

# ── Health-ingest / Wear device token ────────────────────────
# Dedicated token for watch/health ingestion. Must be DIFFERENT from PANEL_PASSWORD.
# If unset, health endpoints stay CLOSED (fail-closed).
HEALTH_INGEST_TOKEN=
WATCH_TOKEN=

# ── LLM providers (OpenAI-compatible). Add any; ORBION fails over. ──
# Primary (optional — e.g. your own gateway). Leave blank to skip.
EVREN_BASE_URL=
EVREN_MODEL=
EVREN_API_KEY=
EVREN_API_KEY_BACKUP=
EVREN_API_KEY_3=

# Google Gemini  (AI Studio free tier)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# Groq  (fast free tier)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Cloudflare Workers AI
CF_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: OpenRouter (free models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional second bot (e.g. a dedicated channel / dev bot)
DEV_BOT_TOKEN=

# ── Mail (Gmail IMAP/SMTP with an app password) ──────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── Cloudflare Tunnel (public panel without opening ports) ───
CF_TUNNEL_URL=

# ── Safety switches ──────────────────────────────────────────
# Shell/exec commands are OFF unless explicitly enabled.
ENABLE_SHELL_CMD=0

# ── Daily limits (guard: warn at 90%, hard-stop at 95%) ──────
LIMIT_KV_WRITE=1000
LIMIT_R2_GB=10
LIMIT_WAI_NEURON=10000
LIMIT_GMAIL_SEND=500
LIMIT_DISK_GB=200
